{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carter-dataset-spec-1.0.schema.json",
  "title": "Carter 1.0 Dataset Specification",
  "description": "Authoritative structural contract for DatasetSpec objects produced by Carter 1.0 Dataset Planner and validated by Dataset Forge before dataset generation.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "status",
    "dataset_type",
    "dataset_name",
    "dataset_description",
    "requested_record_count",
    "effective_record_count",
    "fields",
    "source_policy",
    "grounding_required",
    "evidence_required",
    "generation_requirements",
    "user_constraints",
    "clarification"
  ],

  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "clarification_required",
        "rejected"
      ],
      "description": "Whether the planned DatasetSpec is ready for application validation, requires user clarification, or cannot safely proceed."
    },

    "dataset_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "question_answer",
        "instruction_response",
        "classification",
        "scenario_expected_result",
        "custom",
        null
      ],
      "description": "The primary semantic record pattern selected by Carter. Null is allowed only when planning cannot safely determine a dataset type."
    },

    "dataset_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Concise lowercase kebab-case dataset name. Null is allowed when planning cannot produce a usable specification."
    },

    "dataset_description": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500,
      "description": "A concise description of the intended dataset. This describes intent and must not claim that generation or validation has already succeeded."
    },

    "requested_record_count": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ],
      "description": "The record count explicitly requested by the user. Null means the user did not specify a count."
    },

    "effective_record_count": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ],
      "description": "The record count Carter proposes after applying Dataset Forge defaults and limits. Carter 1.0 PoC permits at most 100 records. Dataset Forge may enforce an even lower runtime limit."
    },

    "fields": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "description": "User-facing semantic fields belonging to each generated dataset record. Application-owned provenance, evidence, validation, provider, and lifecycle fields are excluded.",
      "items": {
        "$ref": "#/$defs/dataset_field"
      }
    },

    "source_policy": {
      "type": "string",
      "const": "selected_documents_only",
      "description": "Carter 1.0 PoC datasets may use only the application-approved selected documents as authoritative source material."
    },

    "grounding_required": {
      "type": "boolean",
      "const": true,
      "description": "Dataset Forge requires source grounding for Carter 1.0 PoC dataset generation. Carter cannot disable this."
    },

    "evidence_required": {
      "type": "boolean",
      "const": true,
      "description": "Dataset Forge requires evidence references for generated records. Carter cannot disable this."
    },

    "generation_requirements": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "uniqueItems": true,
      "description": "Normalized application-supported generation requirements.",
      "items": {
        "type": "string",
        "enum": [
          "source_grounded",
          "diverse_examples",
          "avoid_exact_duplicates",
          "practical_examples",
          "balanced_difficulty_when_requested",
          "balanced_categories_when_requested",
          "follow_user_constraints"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "source_grounded"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "const": "avoid_exact_duplicates"
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },

    "user_constraints": {
      "type": "array",
      "maxItems": 32,
      "description": "Normalized user-requested constraints that affect generation behavior without altering application security or provenance rules.",
      "items": {
        "$ref": "#/$defs/user_constraint"
      }
    },

    "clarification": {
      "$ref": "#/$defs/clarification"
    }
  },

  "$defs": {
    "dataset_field": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "name",
        "type",
        "required",
        "description"
      ],

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "not": {
            "enum": [
              "id",
              "record_id",
              "canonical_record_id",
              "document_id",
              "canonical_document_id",
              "source_ref",
              "source_refs",
              "canonical_source_id",
              "evidence",
              "validation",
              "validation_status",
              "schema_valid",
              "grounding",
              "grounding_status",
              "grounding_score",
              "provider",
              "provider_id",
              "provider_job_id",
              "provider_operation_id",
              "generation_id",
              "artifact_id",
              "artifact_digest",
              "package_ready",
              "security_status",
              "revision_count",
              "created_at",
              "updated_at"
            ]
          },
          "description": "Lowercase snake_case user-facing semantic field name. Reserved Dataset Forge fields are prohibited."
        },

        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "enum",
            "array_string"
          ],
          "description": "Carter 1.0 PoC semantic field type."
        },

        "required": {
          "type": "boolean",
          "description": "Whether this semantic field must exist in every generated record."
        },

        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Human-readable semantic definition of the field."
        },

        "enum_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Allowed values when field type is enum."
        },

        "constraints": {
          "$ref": "#/$defs/field_constraints"
        }
      },

      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enum_values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "enum_values"
              ]
            }
          }
        }
      ]
    },

    "field_constraints": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "min_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },

        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },

        "minimum": {
          "type": "number"
        },

        "maximum": {
          "type": "number"
        },

        "min_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },

        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },

      "description": "Optional simple semantic constraints derived from the user's request. Dataset Forge performs additional semantic consistency validation after JSON Schema validation."
    },

    "user_constraint": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "key",
        "operator",
        "value"
      ],

      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Normalized constraint identifier."
        },

        "operator": {
          "type": "string",
          "enum": [
            "require",
            "prefer",
            "exclude"
          ],
          "description": "Whether the constraint is mandatory, preferred, or exclusionary."
        },

        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          ],
          "description": "Normalized constraint value."
        }
      }
    },

    "clarification": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "required",
        "reason_code",
        "question",
        "reason"
      ],

      "properties": {
        "required": {
          "type": "boolean"
        },

        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "CONFLICTING_DATASET_STRUCTURE",
            "MISSING_CLASSIFICATION_LABELS",
            "AMBIGUOUS_REQUIRED_FIELD",
            "RECORD_LIMIT_EXCEEDED",
            "CONFLICTING_PRIMARY_OBJECTIVE",
            "UNREPRESENTABLE_STRUCTURE",
            null
          ]
        },

        "question": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },

        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "dataset_type": {
            "type": "string",
            "enum": [
              "question_answer",
              "instruction_response",
              "classification",
              "scenario_expected_result",
              "custom"
            ]
          },

          "dataset_name": {
            "type": "string"
          },

          "dataset_description": {
            "type": "string"
          },

          "effective_record_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },

          "fields": {
            "minItems": 1
          },

          "clarification": {
            "properties": {
              "required": {
                "const": false
              },
              "reason_code": {
                "type": "null"
              },
              "question": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "status": {
            "const": "clarification_required"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "clarification": {
            "properties": {
              "required": {
                "const": true
              },
              "reason_code": {
                "type": "string",
                "enum": [
                  "CONFLICTING_DATASET_STRUCTURE",
                  "MISSING_CLASSIFICATION_LABELS",
                  "AMBIGUOUS_REQUIRED_FIELD",
                  "RECORD_LIMIT_EXCEEDED",
                  "CONFLICTING_PRIMARY_OBJECTIVE",
                  "UNREPRESENTABLE_STRUCTURE"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "effective_record_count": {
            "type": "null"
          },
          "clarification": {
            "properties": {
              "required": {
                "const": false
              },
              "question": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],

  "examples": [
    {
      "status": "ready",
      "dataset_type": "question_answer",
      "dataset_name": "software-testing-qa",
      "dataset_description": "A source-grounded question-and-answer dataset covering software-testing concepts from the selected documents.",
      "requested_record_count": 25,
      "effective_record_count": 25,
      "fields": [
        {
          "name": "question",
          "type": "string",
          "required": true,
          "description": "A software-testing question."
        },
        {
          "name": "answer",
          "type": "string",
          "required": true,
          "description": "The ideal source-grounded answer."
        },
        {
          "name": "difficulty",
          "type": "enum",
          "required": true,
          "description": "The difficulty of the question.",
          "enum_values": [
            "easy",
            "medium",
            "hard"
          ]
        }
      ],
      "source_policy": "selected_documents_only",
      "grounding_required": true,
      "evidence_required": true,
      "generation_requirements": [
        "source_grounded",
        "diverse_examples",
        "avoid_exact_duplicates",
        "practical_examples",
        "follow_user_constraints"
      ],
      "user_constraints": [],
      "clarification": {
        "required": false,
        "reason_code": null,
        "question": null,
        "reason": null
      }
    },

    {
      "status": "ready",
      "dataset_type": "classification",
      "dataset_name": "requirements-classification",
      "dataset_description": "A source-grounded dataset for classifying requirements as functional or non-functional.",
      "requested_record_count": null,
      "effective_record_count": 10,
      "fields": [
        {
          "name": "requirement",
          "type": "string",
          "required": true,
          "description": "The requirement to classify."
        },
        {
          "name": "label",
          "type": "enum",
          "required": true,
          "description": "The requirement classification.",
          "enum_values": [
            "functional",
            "non_functional"
          ]
        },
        {
          "name": "explanation",
          "type": "string",
          "required": true,
          "description": "A concise source-grounded explanation of the classification."
        }
      ],
      "source_policy": "selected_documents_only",
      "grounding_required": true,
      "evidence_required": true,
      "generation_requirements": [
        "source_grounded",
        "diverse_examples",
        "avoid_exact_duplicates",
        "practical_examples",
        "follow_user_constraints"
      ],
      "user_constraints": [
        {
          "key": "classification_labels",
          "operator": "require",
          "value": [
            "functional",
            "non_functional"
          ]
        }
      ],
      "clarification": {
        "required": false,
        "reason_code": null,
        "question": null,
        "reason": null
      }
    },

    {
      "status": "clarification_required",
      "dataset_type": "classification",
      "dataset_name": "requirements-classification",
      "dataset_description": "A classification dataset whose required labels have not yet been defined.",
      "requested_record_count": 20,
      "effective_record_count": 20,
      "fields": [
        {
          "name": "requirement",
          "type": "string",
          "required": true,
          "description": "The requirement to classify."
        },
        {
          "name": "label",
          "type": "string",
          "required": true,
          "description": "The classification label, which still requires clarification."
        }
      ],
      "source_policy": "selected_documents_only",
      "grounding_required": true,
      "evidence_required": true,
      "generation_requirements": [
        "source_grounded",
        "avoid_exact_duplicates"
      ],
      "user_constraints": [],
      "clarification": {
        "required": true,
        "reason_code": "MISSING_CLASSIFICATION_LABELS",
        "question": "What labels should Carter 1.0 use for this classification dataset?",
        "reason": "The requested classification task does not define the categories each record should use."
      }
    },

    {
      "status": "clarification_required",
      "dataset_type": "question_answer",
      "dataset_name": "software-testing-qa",
      "dataset_description": "A requested software-testing question-and-answer dataset.",
      "requested_record_count": 5000,
      "effective_record_count": null,
      "fields": [
        {
          "name": "question",
          "type": "string",
          "required": true,
          "description": "A source-grounded software-testing question."
        },
        {
          "name": "answer",
          "type": "string",
          "required": true,
          "description": "The ideal source-grounded answer."
        }
      ],
      "source_policy": "selected_documents_only",
      "grounding_required": true,
      "evidence_required": true,
      "generation_requirements": [
        "source_grounded",
        "avoid_exact_duplicates"
      ],
      "user_constraints": [],
      "clarification": {
        "required": true,
        "reason_code": "RECORD_LIMIT_EXCEEDED",
        "question": "Dataset Forge currently allows at most 100 records per generation. Would you like to generate 100 or fewer records?",
        "reason": "The requested 5000 records exceeds the Carter 1.0 PoC generation limit."
      }
    }
  ]
}